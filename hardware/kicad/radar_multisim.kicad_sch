  (text "1 · VIDEO AMPLIFIER  —  mixer IF in, sound-card line out.  Probe TP_IF TP_AP TP_AOUT TP_BOUT TP_LP TP_AUDIO" (at 14 26 0) (effects (font (size 2 2) bold) (justify left bottom)) (uuid "b7271f4b-240b-4ffe-817e-63ce331412cc"))
  (text "V_IF: Multisim AC_VOLTAGE. 10 mVpk for the low-gain build," (at 14 76 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "30b6f343-c444-4b0e-a0b1-ad677b492efa"))
  (text "0.5 mVpk for full gain (it clips at 10 mV). Bode: AC sweep 1 Hz-100 kHz" (at 14 79.5 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "70e1aadd-bf0e-43c7-8cf5-6a9c9c664f7d"))
  (text "mixer IF source impedance" (at 26 45 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "5c8826a8-62fb-43e5-9684-afc59ba8af2d"))
  (text "gain A = 1 + R3/R4 = 101   (R4 = 4.7k -> 22, first power-up)" (at 62 92 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "a0ae54b9-d628-4859-9fcb-41598092ef69"))
  (text "gain B = 1 + R7/R8 = 11   (R7 = wire link -> 1)" (at 118 95.5 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "e2c85969-cbd4-4e29-990d-7d633870fced"))
  (text "R12/C9: 15.9 kHz low-pass" (at 150 92 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "f88906ef-1115-4cd0-b672-18a4f92f0af1"))
  (text "R_LOAD = sound-card line input" (at 226 76 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "54819558-06c4-453f-a1be-2621ef2190e1"))
  (text "(or drive VREF from frame 2)" (at 276 76 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "e5a3112b-ab8c-4d61-9e98-bba0f5b55390"))
  (text "EXPECTED  low gain (R4 4.7k, R7 link): 10 mVpk in -> 107 mVpk at TP_AUDIO" (at 262 84 0) (effects (font (size 1.1 1.1) bold) (justify left bottom)) (uuid "0b480547-866e-4b52-aafd-0b2eb97db78a"))
  (text "full gain: 54.6 dB from V_IF at 1 kHz, -6 dB at 159 Hz, -3 dB at 15.9 kHz; clips at +/-4.1 V" (at 262 88 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "c4735099-32f5-4866-8cee-bcf87895e5a8"))
  (text "radar input 8 mV @ 12.5 Hz + 40 uV @ 417 Hz -> TP_AUDIO 27 mV leak, 19 mV echo" (at 262 92 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "a077a4bd-03c1-4d23-a29b-9e6bbb455c6d"))
  (text "U1A/U1B/U2B = TL072CP  (Multisim: Analog > OPAMP > TL072CP)" (at 262 96 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "744b46c7-0a90-4069-8df1-c63b73d324a5"))
  (text "2 · HALF-RAIL REFERENCE  —  VREF = VANA/2 buffered" (at 14 104 0) (effects (font (size 2 2) bold) (justify left bottom)) (uuid "db1cfc9c-0df6-428f-b4f7-94b197768b53"))
  (text "ripple test: + 100 mVpk 150 kHz" (at 14 144 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "3ba4af61-6a46-44ae-9496-be96f6c88b16"))
  (text "R_LOAD = the six VREF returns" (at 100 152 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "0a0d1c4b-f1e0-47b1-9023-14ab98b24ee1"))
  (text "EXPECTED  TP_VDIV 5.70 V, TP_VREF 5.70 V, ripple at TP_VREF < 1 uV" (at 14 161 0) (effects (font (size 1.1 1.1) bold) (justify left bottom)) (uuid "6b940812-bc26-4479-9075-ee43e6641fde"))
  (text "3 · 12 V INPUT  —  D1 -> VPROT -> R15/C13 -> VANA" (at 142 104 0) (effects (font (size 2 2) bold) (justify left bottom)) (uuid "0fd984ec-7fd0-4feb-bebf-92e967a7c959"))
  (text "ripple test: + 100 mVpk 150 kHz; reverse test: -12 V" (at 142 152 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "2dcebee3-a031-4994-9649-65adabbdd4de"))
  (text "60 R = the LM2596 drawing 0.2 A" (at 178 140 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "8c26fb29-9cb8-479c-89ac-f7908f5f8d1e"))
  (text "1.1k = two TL072 + dividers" (at 210 140 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "05fdabff-aecd-4734-b4fc-de7c0fc5a727"))
  (text "EXPECTED  TP_VPROT 11.7 V, TP_VANA 11.6 V, ripple 4 mVpp;" (at 142 158 0) (effects (font (size 1.1 1.1) bold) (justify left bottom)) (uuid "166468b6-46b1-44f3-9196-d7e1b8710a60"))
  (text "with V_IN = -12 V: TP_VPROT -0.1 mV, 2 uA" (at 142 162 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "d286ea97-6714-43e5-827a-4cd3a9a14567"))
  (text "4 · SYNC DIVIDER  —  ESP32 GPIO -> 0.3 V -> sound-card R" (at 280 104 0) (effects (font (size 2 2) bold) (justify left bottom)) (uuid "0735bb28-ce86-48b9-8744-4fbbf5fa7348"))
  (text "6.4 ms high, 7.4 ms period, 10 ns edges" (at 280 146 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "3fe680cb-0ea5-4e68-be3c-bd3218c1c45e"))
  (text "GPIO output R" (at 294 117 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "9733199e-9136-4f84-9bd4-439a5f5ca735"))
  (text "C_CPL / R_SC = the sound card's AC-coupled input" (at 330 140 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "8b53d5ad-b303-47af-a1f8-afa18adfd9db"))
  (text "EXPECTED  TP_SYNC 283 mV high / 0 V low;" (at 280 158 0) (effects (font (size 1.1 1.1) bold) (justify left bottom)) (uuid "f283ae83-7b76-46f2-83db-85062e682b57"))
  (text "TP_SC +201 mV drooping / -100 mV retrace pulse -> software detects EDGES" (at 280 162 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "cae1cb7d-33bd-436a-9e4f-0b02cf16468f"))
  (text "5 · THE RADAR ITSELF, SCALED  —  chirp x delayed chirp = beat. Carrier cancels, so B/10 and delay x10 give the real 417 Hz" (at 14 170 0) (effects (font (size 2 2) bold) (justify left bottom)) (uuid "37fdf1c0-bc44-4b0b-9f14-9d3bb105fec3"))
  (text "R12/C9 = the amp's 15.9 kHz LP;  C1/R2, C2/R6 = its two 159 Hz HPs (they kill the leakage tone)" (at 226 222 0) (effects (font (size 1 1)) (justify left bottom)) (uuid "0a167690-fc44-4abe-b1a4-33e2397df9eb"))
  (text "Multisim parts: PIECEWISE_LINEAR_VOLTAGE -> VOLTAGE_CONTROLLED_SINE_WAVE; LOSSLESS_LINE_TYPE1; VOLTAGE_GAIN_BLOCK; VOLTAGE_SUMMER; MULTIPLIER" (at 14 236 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "1c03874c-009a-48c2-9856-ee4604b74fbf"))
  (text "Transient: TMAX 10 ns, stop 19.2 ms (3 chirps). Fourier at TP_BEAT over ONE chirp (6.4 ms), Hanning window." (at 14 240 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "eccd15b0-a820-4ebb-a4ff-59d4789e79d5"))
  (text "EXPECTED  leakage gain x0: peak at 417 Hz, 4.5 mV.   TD1 = 333 ns -> 208 Hz.   TD1 = 1.33 us -> 833 Hz (20 m)." (at 14 246 0) (effects (font (size 1.1 1.1) bold) (justify left bottom)) (uuid "ca5dee91-10ae-4888-9f38-2c3938b72be4"))
  (text "Leakage gain x1: the 417 Hz line is unchanged but the spectrum floor rises 20 dB near DC - what chirp-to-chirp subtraction removes in software." (at 14 250 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "124f3e20-1bde-4235-b9ed-4f0abfe567d6"))
  (text "Real radar: B = 40 MHz, TD = 66.7 ns (10 m), T = 6.4 ms  ->  f_beat = B x TD / T = 417 Hz.  Here: B = 4 MHz, TD = 667 ns. Same answer." (at 14 254 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "71cf4368-64a8-42de-8183-75dd400fdb15"))
  (text "The blocks right of the mixer's IF port cannot be simulated in Multisim (no 2.4 GHz models): ADF4351, SPF5189Z, splitter, mixer, horns are measured, not modelled." (at 14 258 0) (effects (font (size 1.1 1.1)) (justify left bottom)) (uuid "06e04c6c-0033-4810-a0ba-28250c320e59"))
  (text "PARTS  resistors 1 % 1/4 W · 100n / 10n film or C0G · 10u 47u 100u electrolytic 25 V (+ marked) · 1N5822 · TL072CP x3 · single 12 V rail" (at 14 270 0) (effects (font (size 1.2 1.2)) (justify left bottom)) (uuid "1ac7ebb7-ed77-48b6-b9f5-87468d17d8b5"))
  (text "Netlists that produced the EXPECTED lines: hardware/spice/*.cir (ngspice 42).  Same values as the breadboard sheet radar_breadboard.kicad_sch." (at 14 274 0) (effects (font (size 1.2 1.2)) (justify left bottom)) (uuid "2e347fa3-defe-4ee6-9bfb-7b976e50b813"))

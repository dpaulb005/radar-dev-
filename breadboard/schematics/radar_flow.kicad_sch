  (text "RF FRONT END  —  bought modules, SMA to SMA.  Nothing here has a SPICE model at 2.4 GHz, so every one is measured on the bench, never simulated." (at 15 23 0) (effects (font (size 1.85 1.85) bold) (justify left bottom)) (uuid "5b78c5d2-0787-4def-a5a1-8c68ac30553d"))
  (text "ADF4351 PLL" (at 31 47.21 0) (effects (font (size 1.35 1.35) bold) (justify left bottom)) (uuid "c2dc9576-75d6-43e0-899b-fa7442a88561"))
  (text "64 steps of 625 kHz, 100 us each.\nThat is the 6.4 ms up-chirp." (at 31 50.81 0) (effects (font (size 1.05 1.05)) (justify left bottom)) (uuid "c97ba976-51a0-4bd8-81e3-8822e7d38d36"))
  (text "3 dB pad" (at 85 44.67 0) (effects (font (size 1.35 1.35) bold) (justify left bottom)) (uuid "e5157c8e-ce49-4455-8e66-cae980939d1b"))
  (text "flattens the PLL\ninto 50 ohm" (at 85 48.27 0) (effects (font (size 1.05 1.05)) (justify left bottom)) (uuid "f910399c-028c-48dc-b060-570d9955d550"))
  (text "SPF5189Z PA" (at 132 47.21 0) (effects (font (size 1.35 1.35) bold) (justify left bottom)) (uuid "21167148-35ce-4bd7-b107-8085a966b5c2"))
